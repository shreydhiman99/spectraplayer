<Window x:Class="SpectraPlayer.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" Title="Settings"
        Width="700" Height="660" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown" Closed="OnClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="ChipTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <Button Style="{StaticResource KeyChipButton}" Content="{Binding Text}" Click="OnChipClick"
                        ToolTip="Click, then press the new key"/>
                <Button Style="{StaticResource IconButton}" Width="20" Height="24" FontSize="9" Content="&#xE711;"
                        Foreground="{StaticResource TextDimBrush}" Click="OnChipRemove" ToolTip="Remove this key"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate">
            <Border Padding="8,4" CornerRadius="5" BorderThickness="1" Margin="0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Not set" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoKey, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="12" Content="&#xE710;"
                            Click="OnAddKey" ToolTip="Add another key for this action"/>
                    <Button Grid.Column="3" Width="28" Height="26" FontSize="12" Content="&#xE7A7;" Click="OnResetRow"
                            ToolTip="Back to the default key">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomised}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,4"
                           Foreground="{StaticResource AccentHoverBrush}"/>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="26,18,16,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,10,10">
            <TextBlock Text="Keyboard shortcuts" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                       Text="Click a key to change it, then press the new key. Use + to give an action a second key. Changes apply straight away and are remembered."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,10,8">
            <Border x:Name="RecordBanner" Visibility="Collapsed" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource TextButton}" Padding="10,2" MinWidth="0"
                            FontSize="12" Focusable="False" Click="OnCancelRecording"/>
                    <TextBlock x:Name="RecordText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                </DockPanel>
            </Border>
            <TextBlock x:Name="Notice" Visibility="Collapsed" Margin="2,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{StaticResource NoteBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <ItemsControl x:Name="Groups" ItemTemplate="{StaticResource GroupTemplate}"/>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,12,10,0">
            <Button x:Name="ResetAllButton" DockPanel.Dock="Left" Content="Reset all to defaults" Style="{StaticResource TextButton}"
                    Focusable="False" Click="OnResetAll"/>
            <Button Content="Close" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="100" Padding="14,6"/>
        </DockPanel>
    </Grid>
</Window>
