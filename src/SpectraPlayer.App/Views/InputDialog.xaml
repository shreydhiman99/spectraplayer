<Window x:Class="SpectraPlayer.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Width="400" SizeToContent="Height" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="Prompt" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
        <TextBox x:Name="Input" MaxLength="2000" PreviewKeyDown="OnInputKeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource TextButton}" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource TextButton}" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
