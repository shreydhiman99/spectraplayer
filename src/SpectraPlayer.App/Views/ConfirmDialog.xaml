<Window x:Class="SpectraPlayer.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,22,24,22">
        <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource TextButton}" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource TextButton}" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
