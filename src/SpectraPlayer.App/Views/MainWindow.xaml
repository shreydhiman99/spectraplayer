<Window x:Class="SpectraPlayer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SpectraPlayer.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Spectraplayer" Icon="/Assets/spectraplayer.ico" Width="1100" Height="680" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" UseLayoutRounding="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        SourceInitialized="OnSourceInitialized" StateChanged="OnStateChanged"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnAnyMouseDown" Closing="OnClosing">

    <!-- Our own title bar replaces the Windows one (which Windows 10 paints in the user's accent colour). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ContextMenu x:Key="PlayerMenu">
            <!-- Tag = the action whose key is shown on the right (kept up to date when shortcuts change) -->
            <MenuItem Header="Open file…" Tag="OpenFile" Click="OnOpenClick"/>
            <MenuItem Header="Add folder as tab…" Tag="NewTab" Click="OnNewTabClick"/>
            <Separator/>
            <MenuItem Header="Play / Pause" Tag="TogglePause" Click="OnPlayClick"/>
            <MenuItem Header="Previous video" Tag="PreviousVideo" Click="OnPreviousClick"/>
            <MenuItem Header="Next video" Tag="NextVideo" Click="OnNextClick"/>
            <MenuItem Header="Fullscreen" Tag="ToggleFullscreen" Click="OnFullscreenClick"/>
            <Separator/>
            <MenuItem Header="Playlist" Tag="TogglePlaylist" Click="OnTogglePlaylistClick"/>
            <MenuItem Header="Take note…" Tag="NewNote" Click="OnTakeNoteClick"/>
            <MenuItem Header="Mark section start" Tag="MarkSectionStart" Click="OnSectionStartClick"/>
            <MenuItem Header="Mark section end" Tag="MarkSectionEnd" Click="OnSectionEndClick"/>
            <MenuItem Header="Add bookmark" Tag="AddBookmark" Click="OnAddBookmarkClick"/>
            <MenuItem Header="Bookmarks" Tag="ToggleBookmarks" Click="OnToggleBookmarksClick"/>
            <MenuItem Header="Import bookmarks (.pbf)…" Click="OnImportBookmarks"/>
            <MenuItem Header="Export bookmarks (.pbf)…" Click="OnExportBookmarks"/>
            <Separator/>
            <MenuItem Header="Settings…" Tag="OpenSettings" Click="OnSettingsClick"/>
            <MenuItem Header="Keyboard shortcuts…" Tag="ShowShortcuts" Click="OnShortcutsClick"/>
            <MenuItem Header="About Spectraplayer…" Click="OnAboutClick"/>
            <MenuItem Header="Exit" Click="OnExitClick"/>
        </ContextMenu>

        <ContextMenu x:Key="TabMenu">
            <MenuItem Header="Rename…" Click="OnTabRename"/>
            <MenuItem Header="Rescan folder" Click="OnTabRescan"/>
            <MenuItem Header="Show in Explorer" Click="OnTabShowInExplorer"/>
            <Separator/>
            <MenuItem Header="Move left" Click="OnTabMoveLeft"/>
            <MenuItem Header="Move right" Click="OnTabMoveRight"/>
            <Separator/>
            <MenuItem Header="Close tab" Tag="CloseTab" Click="OnTabClose"/>
        </ContextMenu>

        <ContextMenu x:Key="PlaylistItemMenu">
            <MenuItem Header="Play" Click="OnPlaylistPlay"/>
            <MenuItem Header="Mark as watched" Click="OnPlaylistMarkWatched"/>
            <MenuItem Header="Mark as unwatched" Click="OnPlaylistMarkUnwatched"/>
            <Separator/>
            <MenuItem Header="Show in Explorer" Click="OnPlaylistShowInExplorer"/>
        </ContextMenu>

        <ContextMenu x:Key="NotesMenu">
            <MenuItem Header="Export this video's notes…" Click="OnExportVideoNotes"/>
            <MenuItem Header="Export this tab's notes…" Click="OnExportTabNotes"/>
            <Separator/>
            <MenuItem Header="Copy this video's notes as Markdown" Click="OnCopyVideoNotes"/>
        </ContextMenu>

        <ContextMenu x:Key="NoteItemMenu">
            <MenuItem Header="Go to" Click="OnNoteGoTo"/>
            <MenuItem Header="Edit…" InputGestureText="F2" Click="OnNoteEdit"/>
            <MenuItem Header="Copy text" Click="OnNoteCopy"/>
            <MenuItem Header="Delete" InputGestureText="Del" Click="OnNoteDelete"/>
        </ContextMenu>

        <ContextMenu x:Key="TranscriptItemMenu">
            <MenuItem Header="Go to" Click="OnTranscriptGoTo"/>
            <MenuItem Header="Make note from selected lines" Click="OnTranscriptMakeNote"/>
            <MenuItem Header="Copy" Click="OnTranscriptCopy"/>
        </ContextMenu>

        <ContextMenu x:Key="BookmarkItemMenu">
            <MenuItem Header="Go to" Click="OnBookmarkGoTo"/>
            <MenuItem Header="Rename…" InputGestureText="F2" Click="OnBookmarkRename"/>
            <MenuItem Header="Delete" InputGestureText="Del" Click="OnBookmarkDelete"/>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="Root" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: logo, one tab per folder (subject), and the window buttons. Empty space between them drags the window. -->
        <Border x:Name="TabBar" Grid.Row="0" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="44" Height="36"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="About Spectraplayer" Click="OnAboutClick">
                    <Image Source="{StaticResource SpectraLogo}" Width="20" Height="20"/>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimise" Click="OnMinimizeClick"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximise" Click="OnMaximizeClick"/>
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnCloseClick"/>
                </StackPanel>

                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" Width="34" Height="28"
                        FontSize="15" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Settings" Click="OnSettingsClick"/>

                <Button x:Name="NewTabButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" Margin="2,0,2,0" Height="28"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Add folder as tab" Click="OnNewTabClick"/>

                <Grid>
                    <ListBox x:Name="TabList" Style="{StaticResource TabListBox}" HorizontalAlignment="Left"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             SelectionChanged="OnTabSelectionChanged" PreviewMouseWheel="OnTabWheel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource TabItemStyle}">
                                <Setter Property="ContextMenu" Value="{StaticResource TabMenu}"/>
                                <EventSetter Event="PreviewMouseUp" Handler="OnTabMouseUp"/>
                                <EventSetter Event="Button.Click" Handler="OnTabCloseClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" ToolTip="{Binding Folder}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}" Margin="6,0,0,0"
                                            ToolTip="Close tab"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" FontSize="12.5"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="TabHint" Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource TextDimBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Text="Add a folder with + to make a tab, for example one per subject"/>
                </Grid>
            </DockPanel>
        </Border>

        <Grid x:Name="ContentArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Video surface (or the welcome screen, while nothing is open) -->
            <Grid x:Name="VideoArea" Grid.Column="0" Background="Black"
                  MouseLeftButtonDown="OnVideoMouseDown" MouseRightButtonUp="OnVideoRightClick"
                  MouseWheel="OnVideoWheel" MouseMove="OnVideoMouseMove">
                <!-- Hidden while there is nothing to play: the welcome screen shows instead. -->
                <c:VideoHost x:Name="Video" Visibility="Hidden"/>

                <!-- Welcome screen: shown when no video is open (or libmpv could not be loaded) -->
                <Grid x:Name="WelcomePanel" AllowDrop="True" MouseLeftButtonDown="OnWelcomeMouseDown">
                    <Grid.Background>
                        <RadialGradientBrush Center="0.5,0.34" GradientOrigin="0.5,0.34" RadiusX="0.75" RadiusY="0.85">
                            <GradientStop Color="#1B2347" Offset="0"/>
                            <GradientStop Color="#0B0C10" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Margin="32,16">
                            <Image Source="{StaticResource SpectraLogo}" Width="72" Height="72" HorizontalAlignment="Center"/>
                            <TextBlock Text="Spectraplayer" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Study with your videos" FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextDimBrush}"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource WelcomeButton}" Click="OnOpenClick">
                                    <StackPanel>
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource AccentHoverBrush}"/>
                                        <TextBlock Text="Open a video" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="WelcomeOpenHint" Text="Ctrl+O" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource WelcomeButton}" Click="OnNewTabClick">
                                    <StackPanel>
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource MarkerBrush}"/>
                                        <TextBlock Text="Add a folder as a tab" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="WelcomeTabHint" Text="One tab per subject  ·  Ctrl+T" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="WelcomeNotice" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,18,0,0" FontSize="13" Foreground="{StaticResource DangerBrush}"/>

                            <StackPanel x:Name="WelcomeSubjects" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="Continue studying" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                <ItemsControl x:Name="WelcomeTabs" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SubjectChip}" Content="{Binding Title}" ToolTip="{Binding Folder}"
                                                    Click="OnWelcomeSubjectClick"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,10"/>

                            <TextBlock Text="Shortcuts" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="WelcomeShortcuts" ItemTemplate="{StaticResource ShortcutGroupTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                                       Text="You can also drop a video or a folder onto this window"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0" Opacity="0.85">
                                <Image Source="/Assets/neuspectra-light.png" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="Spectraplayer by NeuSpectra" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="© 2026 NeuSpectra" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Side panel: playlist of the active tab, or bookmarks of the current video -->
            <!-- The panel is 340 wide, drawn from its left edge, and clipped: animating the Border's width (or the width of
                 the window that holds it, see MainWindow.Panel.cs) slides the content in and out without re-flowing it. -->
            <Border x:Name="SidePanel" Grid.Column="1" Width="340" HorizontalAlignment="Left" ClipToBounds="True"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Width="339" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="PanelHideButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Content="&#xE89F;" FontSize="14" Width="32" Height="28" Margin="0,0,6,2"
                                    ToolTip="Hide the panel. Move the mouse to the right edge to bring it back" Click="OnHidePanelClick"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PanelPlaylistButton" GroupName="Panel" Content="Playlist" IsChecked="True"
                                             Style="{StaticResource SegmentButton}" Click="OnPanelPlaylistClick"/>
                                <RadioButton x:Name="PanelNotesButton" GroupName="Panel" Content="Notes"
                                             Style="{StaticResource SegmentButton}" Click="OnPanelNotesClick"/>
                                <RadioButton x:Name="PanelTranscriptButton" GroupName="Panel" Content="Transcript"
                                             Style="{StaticResource SegmentButton}" Click="OnPanelTranscriptClick"/>
                                <RadioButton x:Name="PanelBookmarksButton" GroupName="Panel" Content="Bookmarks"
                                             Style="{StaticResource SegmentButton}" Click="OnPanelBookmarksClick"/>
                                <RadioButton x:Name="PanelFocusButton" GroupName="Panel" Content="Focus"
                                             Style="{StaticResource SegmentButton}" Click="OnPanelFocusClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Playlist -->
                    <Grid x:Name="PlaylistView" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="14,12,14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PlaylistTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PlaylistSummary" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- the length of the whole playlist, as a clock -->
                            <StackPanel x:Name="PlaylistTotalBox" Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock x:Name="PlaylistTotal" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="total length" FontSize="11" Margin="0,1,0,0" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="PlaylistList" Grid.Row="1" Style="{StaticResource ThemedListBox}"
                                 MouseDoubleClick="OnPlaylistDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}">
                                    <Setter Property="ContextMenu" Value="{StaticResource PlaylistItemMenu}"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnPlaylistRightClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontFamily="Consolas" FontSize="12"
                                                   Margin="10,1,0,0" VerticalAlignment="Top" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Top" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subfolder}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       Visibility="{Binding HasSubfolder, Converter={StaticResource BoolToVis}}"/>
                                            <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Margin="0,5,0,0"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="PlaylistEmpty" Grid.Row="1" Margin="18,6" TextWrapping="Wrap" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Notes -->
                    <Grid x:Name="NotesView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="14,10,8,6">
                            <TextBlock Text="This video" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="NoteCount" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource IconButton}" Width="30" Height="26" FontSize="14" Content="&#xE712;"
                                        ToolTip="Export or copy notes" Click="OnNotesMenuClick"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="NoteList" Grid.Row="1" Style="{StaticResource ThemedListBox}"
                                 MouseDoubleClick="OnNoteDoubleClick" KeyDown="OnNoteListKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}">
                                    <Setter Property="ContextMenu" Value="{StaticResource NoteItemMenu}"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnNoteRightClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeLabel}" FontFamily="Consolas" FontSize="12.5"
                                                   Foreground="{StaticResource NoteBrush}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoteEmpty" Grid.Row="1" Margin="18,6" TextWrapping="Wrap" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False"
                                   Text="No notes on this video yet."/>

                        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,10,12,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="NoteStamp" Foreground="{StaticResource NoteBrush}" FontFamily="Consolas"
                                               FontSize="12.5" VerticalAlignment="Center" Text="at 00:00"/>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="28" Height="22" FontSize="11"
                                            Content="&#xE72C;" ToolTip="Use the current time" Click="OnNoteStampReset"/>
                                </Grid>
                                <Grid>
                                    <TextBox x:Name="NoteInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto" MaxLength="2000"
                                             TextChanged="OnNoteInputChanged" PreviewKeyDown="OnNoteInputKeyDown"/>
                                    <TextBlock x:Name="NotePlaceholder" Margin="10,8" IsHitTestVisible="False"
                                               Foreground="{StaticResource TextDimBrush}" Text="Write a note…  (Ctrl+Enter to add)"/>
                                </Grid>
                                <Button Content="Add note" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                        Margin="0,8,0,0" Focusable="False" Click="OnAddNoteClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Transcript: pick a section, transcribe it, read along, turn lines into notes -->
                    <Grid x:Name="TranscriptView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section -->
                        <StackPanel Grid.Row="0" Margin="14,10,14,10">
                            <Grid>
                                <TextBlock Text="Section" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectionLength" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            </Grid>
                            <TextBlock x:Name="SelectionText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13"
                                       ToolTip="Mark with I and O, or hold Shift and drag on the seek bar"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SetStartButton" Content="Set start  (I)" Style="{StaticResource TextButton}" Padding="8,5" FontSize="12" Focusable="False" Click="OnSectionStartClick"/>
                                <Button x:Name="SetEndButton" Grid.Column="2" Content="Set end  (O)" Style="{StaticResource TextButton}" Padding="8,5" FontSize="12" Focusable="False" Click="OnSectionEndClick"/>
                            </Grid>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Last 2 min" Style="{StaticResource TextButton}" Padding="9,4" MinWidth="0" FontSize="12" Margin="0,0,6,0" Focusable="False" Click="OnSectionLast2Click"/>
                                <Button Content="Last 5 min" Style="{StaticResource TextButton}" Padding="9,4" MinWidth="0" FontSize="12" Margin="0,0,6,0" Focusable="False" Click="OnSectionLast5Click"/>
                                <Button Content="Whole video" Style="{StaticResource TextButton}" Padding="9,4" MinWidth="0" FontSize="12" Margin="0,0,6,0" Focusable="False" Click="OnSectionWholeClick"/>
                                <Button Content="Clear" Style="{StaticResource TextButton}" Padding="9,4" MinWidth="0" FontSize="12" Margin="0,0,6,0" Focusable="False" Click="OnSectionClearClick"/>
                                <Button x:Name="SectionLoopButton" Content="Loop it" Style="{StaticResource TextButton}" Padding="9,4" MinWidth="0" FontSize="12" Focusable="False"
                                        ToolTip="Play only the marked section, to check it" Click="OnSectionLoopClick"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Transcribe -->
                        <Border Grid.Row="1" Padding="14,10,14,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1">
                            <StackPanel>
                                <Button x:Name="TranscribeButton" Content="Transcribe section" Style="{StaticResource PrimaryButton}"
                                        Padding="10,7" Focusable="False" Click="OnTranscribeClick"
                                        ToolTip="Turn the speech in the marked section into text, on this computer"/>
                                <StackPanel x:Name="TranscribeBusy" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource TextButton}" Padding="10,3" MinWidth="0"
                                                FontSize="12" Focusable="False" Click="OnTranscribeCancelClick"/>
                                        <TextBlock x:Name="TranscribeStage" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="TranscribeBar" Style="{StaticResource ThinProgress}" Maximum="1" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Button x:Name="ModelButton" Style="{StaticResource TextButton}" Margin="0,8,0,0" Padding="8,3" MinWidth="0"
                                        HorizontalAlignment="Left" FontSize="12" Focusable="False" Click="OnModelButtonClick"
                                        ToolTip="Where the text comes from: a subtitle file next to the video, or a speech model (accuracy against speed)"/>
                                <TextBlock x:Name="SourceInfo" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TranscribeStatus" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- The text -->
                        <ListBox x:Name="TranscriptList" Grid.Row="2" Style="{StaticResource ThemedListBox}" SelectionMode="Extended"
                                 MouseDoubleClick="OnTranscriptDoubleClick" KeyDown="OnTranscriptKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}">
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource TranscriptItemMenu}"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnTranscriptRightClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeLabel}" FontFamily="Consolas" FontSize="12.5" Margin="0,1,10,0" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="TranscriptEmpty" Grid.Row="2" Margin="18,10" TextWrapping="Wrap" VerticalAlignment="Top"
                                   FontSize="12.5" Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False"/>

                        <!-- Footer -->
                        <Border Grid.Row="3" Padding="14,8,14,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TranscriptNoteButton" Content="Make note" Style="{StaticResource TextButton}"
                                        Padding="8,6" FontSize="12" Focusable="False" Click="OnTranscriptMakeNote"
                                        ToolTip="Select lines (Ctrl or Shift for several), then turn them into a note on this video"/>
                                <Button x:Name="TranscriptCopyButton" Grid.Column="2" Content="Copy" Style="{StaticResource TextButton}"
                                        Padding="12,6" MinWidth="0" FontSize="12" Focusable="False" Click="OnTranscriptCopy"
                                        ToolTip="Copy the selected lines, or all lines if none are selected"/>
                                <Button x:Name="TranscriptExportButton" Grid.Column="4" Content="Export  ▾" Style="{StaticResource TextButton}"
                                        Padding="12,6" MinWidth="0" FontSize="12" Focusable="False" Click="OnTranscriptExportClick"
                                        ToolTip="Save the selected lines, or all lines, as a Markdown document or a subtitle file"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bookmarks -->
                    <Grid x:Name="BookmarksView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="14,12,14,8">
                            <TextBlock Text="This video" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BookmarkCount" HorizontalAlignment="Right" Foreground="{StaticResource TextDimBrush}"/>
                        </Grid>
                        <ListBox x:Name="BookmarkList" Grid.Row="1" Style="{StaticResource ThemedListBox}"
                                 MouseDoubleClick="OnBookmarkDoubleClick" KeyDown="OnBookmarkListKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}">
                                    <Setter Property="ContextMenu" Value="{StaticResource BookmarkItemMenu}"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnBookmarkRightClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" Width="58"
                                                   Foreground="{StaticResource MarkerBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="BookmarkEmpty" Grid.Row="1" Margin="18,6" TextWrapping="Wrap" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False"
                                   Text="No bookmarks yet."/>
                        <Button Grid.Row="2" Content="Add bookmark here" Style="{StaticResource TextButton}" Margin="14,8,14,14"
                                Focusable="False" Click="OnAddBookmarkClick"/>
                    </Grid>

                    <!-- Focus timer: study in timed sessions with breaks -->
                    <ScrollViewer x:Name="FocusView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,14,20,12">
                            <Grid>
                                <TextBlock Text="Focus session" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FocusSessionText" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </Grid>

                            <Grid Width="162" Height="162" Margin="0,10,0,0" HorizontalAlignment="Center">
                                <c:RingProgress x:Name="FocusRing" Thickness="9" TrackBrush="{StaticResource LineBrush}"
                                                ArcBrush="{StaticResource FocusBrush}"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="FocusTime" FontFamily="Consolas" FontSize="36" HorizontalAlignment="Center" Text="25:00"/>
                                    <TextBlock x:Name="FocusPhaseLabel" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" Text="FOCUS"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button x:Name="FocusResetButton" Style="{StaticResource CircleButton}" Content="&#xE72C;" ToolTip="Reset the timer"
                                        Click="OnFocusResetClick"/>
                                <Button x:Name="FocusStartButton" Style="{StaticResource CircleButton}" Width="60" Height="60" FontSize="22"
                                        Margin="16,0" Background="{StaticResource AccentBrush}" Foreground="White" Content="&#xE768;"
                                        ToolTip="Start" Click="OnFocusStartClick"/>
                                <Button x:Name="FocusSkipButton" Style="{StaticResource CircleButton}" Content="&#xE893;" ToolTip="Skip to the next part"
                                        Click="OnFocusSkipClick"/>
                            </StackPanel>

                            <StackPanel x:Name="FocusDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Ellipse Width="12" Height="12" StrokeThickness="2" Margin="5,0"/>
                                <Ellipse Width="12" Height="12" StrokeThickness="2" Margin="5,0"/>
                                <Ellipse Width="12" Height="12" StrokeThickness="2" Margin="5,0"/>
                                <Ellipse Width="12" Height="12" StrokeThickness="2" Margin="5,0"/>
                            </StackPanel>

                            <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Text="Length (focus / break, minutes)" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                    <UniformGrid x:Name="FocusPresets" Rows="1" Margin="0,8,0,0">
                                        <RadioButton GroupName="FocusPreset" Style="{StaticResource ChipToggle}" Margin="0,0,3,0" Click="OnFocusPresetClick"/>
                                        <RadioButton GroupName="FocusPreset" Style="{StaticResource ChipToggle}" Margin="3,0" Click="OnFocusPresetClick"/>
                                        <RadioButton GroupName="FocusPreset" Style="{StaticResource ChipToggle}" Margin="3,0" Click="OnFocusPresetClick"/>
                                        <RadioButton GroupName="FocusPreset" Style="{StaticResource ChipToggle}" Margin="3,0,0,0" Click="OnFocusPresetClick"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,10,0,0">
                                <CheckBox x:Name="FocusPauseVideoBox" Style="{StaticResource ToggleSwitch}" Content="Pause the video during breaks"
                                          Click="OnFocusOptionClick"/>
                                <CheckBox x:Name="FocusChimeBox" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"
                                          Content="Soft chime when a part ends" Click="OnFocusOptionClick"/>
                                <CheckBox x:Name="FocusCountPlayingBox" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"
                                          Content="Count only while the video plays" Click="OnFocusOptionClick"/>
                            </StackPanel>

                            <TextBlock x:Name="FocusTodayText" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Control bar. In fullscreen it is moved into a small overlay window (see SetFullscreen). -->
        <Border x:Name="ControlBar" Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,2,8,6">
            <StackPanel>
                <c:SeekBar x:Name="Seek" SeekRequested="OnSeekRequested" SectionDragged="OnSectionDragged"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Open file" Click="OnOpenClick"/>
                        <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous video" Click="OnPreviousClick"/>
                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play / Pause" Click="OnPlayClick"/>
                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next video" Click="OnNextClick"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop" Click="OnStopClick"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextDimBrush}" Text="00:00 / 00:00"/>
                        <!-- the focus timer, while one is running or paused part-way -->
                        <Button x:Name="FocusPill" Style="{StaticResource FocusPillButton}" Margin="14,0,0,0" Visibility="Collapsed"
                                Click="OnFocusPillClick">
                            <StackPanel Orientation="Horizontal">
                                <c:RingProgress x:Name="FocusPillRing" Width="20" Height="20" Thickness="2.5"
                                                TrackBrush="{StaticResource HoverBrush}" ArcBrush="{StaticResource FocusBrush}"/>
                                <TextBlock x:Name="FocusPillText" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="NowPlaying" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="18,0" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDimBrush}"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="BookmarkButton" Style="{StaticResource IconButton}" Content="&#xE7C1;" ToolTip="Add bookmark" Click="OnAddBookmarkClick"/>
                        <Button x:Name="PlaylistToggleButton" Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="Playlist / Bookmarks" Click="OnTogglePlaylistClick"/>
                        <Button x:Name="SpeedButton" Style="{StaticResource IconButton}" FontFamily="Segoe UI" FontSize="12.5"
                                FontWeight="SemiBold" Width="56" Content="1×" Click="OnSpeedClick" Margin="6,0,0,0"
                                ToolTip="Playback speed: click for presets. C faster, X slower, Z normal"/>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mute" Click="OnMuteClick" Margin="8,0,0,0"/>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource ThemedSlider}" Width="90" Minimum="0" Maximum="100" Value="100"
                                VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Fullscreen" Click="OnFullscreenClick" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
