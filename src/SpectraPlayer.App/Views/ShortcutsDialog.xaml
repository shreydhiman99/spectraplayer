<Window x:Class="SpectraPlayer.App.Views.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" Title="Keyboard shortcuts"
        Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner">
    <Grid Margin="26,18,18,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <ItemsControl x:Name="Groups" ItemTemplate="{StaticResource ShortcutGroupTemplate}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,14,8,0">
            <Button DockPanel.Dock="Left" Content="Change shortcuts…" Style="{StaticResource TextButton}" Focusable="False" Click="OnChangeClick"/>
            <Button Content="Close" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="100" Padding="14,6"/>
        </DockPanel>
    </Grid>
</Window>
