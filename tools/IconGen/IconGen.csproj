<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders src/SpectraPlayer.App/Assets/Logo.xaml into spectraplayer.ico and docs/logo.png. Run it with: dotnet run, from this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
